# Copia este archivo a .env (frontend/Vercel) y configura los secretos de
# Edge Functions con `supabase secrets set --env-file .env.functions` usando
# un archivo separado que NUNCA se commitea. Ver SPEC.md §5.1 y CLAUDE.md
# regla de oro #4: los secretos nunca van al frontend.

# ============================================================================
# FRONTEND (Vite) — se incluyen en el bundle que corre en el navegador.
# Solo deben vivir aquí valores que es seguro exponer públicamente.
# ============================================================================

# URL del proyecto de Supabase (dashboard > Project Settings > API).
VITE_SUPABASE_URL=

# Llave pública "anon" de Supabase. Protegida por RLS, por eso es segura
# de exponer en el navegador (dashboard > Project Settings > API).
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# BACKEND — secretos de Supabase Edge Functions (`supabase secrets set`) y/o
# variables de entorno de las funciones de Vercel (/api/quote-pdf).
# NUNCA van en el frontend ni se commitean con valores reales.
# ============================================================================

# --- Supabase (service role, bypassea RLS; solo en el servidor) -----------

# URL del proyecto de Supabase. Las Edge Functions ya la reciben
# automáticamente como SUPABASE_URL; se repite aquí para las funciones
# de Vercel (/api/quote-pdf) que necesitan conectarse a la misma base.
SUPABASE_URL=

# Service role key de Supabase. Permite leer y escribir todas las tablas
# sin pasar por RLS. Usada por las Edge Functions y por /api/quote-pdf
# para guardar pdf_path. Nunca debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (número de teléfono por negocio) -------------------------------

# SID de la cuenta de Twilio (console.twilio.com).
TWILIO_ACCOUNT_SID=

# Auth token de Twilio, usado también para verificar la firma
# X-Twilio-Signature de los webhooks entrantes.
TWILIO_AUTH_TOKEN=

# --- Vapi (agente de voz) ---------------------------------------------------

# Llave de API de Vapi, para crear/actualizar asistentes e importar números.
VAPI_API_KEY=

# Secreto configurado en el "Server URL" de Vapi para verificar que los
# webhooks de fin de llamada (voice-webhook) realmente vienen de Vapi.
VAPI_SERVER_SECRET=

# Todas las siguientes son opcionales — provision-business trae un valor por
# defecto si las dejas vacías. SPEC dice que el modelo del agente de voz "se
# elige dentro de Vapi, priorizando la latencia, se prueba con llamadas
# reales": usa estas variables para ajustarlo sin tocar código. Antes de la
# primera llamada de prueba, conecta tus llaves de Anthropic y Deepgram
# dentro del dashboard de Vapi (Settings → Provider Keys) — si no, Vapi no
# puede usarlas aunque el assistant las referencie.

# Proveedor del modelo del agente de voz (ej. anthropic). Default: anthropic.
VAPI_ASSISTANT_MODEL_PROVIDER=

# Modelo del agente de voz. Default: claude-haiku-4-5-20251001.
VAPI_ASSISTANT_MODEL=

# Proveedor de voz (texto a voz). Default: vapi (voces propias de Vapi, sin
# necesitar otra llave de API).
VAPI_VOICE_PROVIDER=

# ID de la voz dentro del proveedor elegido. Default: Paige. Verifica en el
# dashboard de Vapi (Voice Library) que ese ID exista antes de activar una línea.
VAPI_VOICE_ID=

# --- WhatsApp Cloud API (Meta) ---------------------------------------------

# Token de acceso permanente de la app de WhatsApp Cloud API (System User).
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono de WhatsApp del producto (uno solo, le escribe
# a todos los dueños).
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA), para administrar plantillas.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token que Meta reenvía al verificar el webhook (GET de verificación).
WHATSAPP_VERIFY_TOKEN=

# App secret de la app de Meta, usado para verificar la firma
# X-Hub-Signature-256 de cada webhook entrante.
WHATSAPP_APP_SECRET=

# Opcional. Versión de la Graph API para mandar mensajes (ej. v21.0). Si
# Meta deprecia la versión actual, cambia esto en vez de tocar código.
WHATSAPP_API_VERSION=

# --- Anthropic (Claude) -----------------------------------------------------

# Llave de API de Anthropic. Haiku para resúmenes/clasificación, Sonnet
# para extracción de cotizaciones (ver SPEC §5.1).
ANTHROPIC_API_KEY=

# Opcional. Modelo usado por voice-webhook para generar summary_es.
# Default: claude-haiku-4-5-20251001 (fijado en CLAUDE.md, no cambiar sin
# preguntar).
CALL_SUMMARY_MODEL=

# --- Transcripción de notas de voz (Deepgram o Whisper) ---------------------

# Llave de Deepgram, si se usa para transcribir las notas de voz del dueño.
DEEPGRAM_API_KEY=

# Llave de OpenAI, si se usa Whisper en vez de Deepgram para transcribir.
OPENAI_API_KEY=

# --- Resend (email al cliente final) ---------------------------------------

# Llave de API de Resend.
RESEND_API_KEY=

# Dirección "from" verificada en el dominio propio (ej. quotes@socio-ai.com)
# usada para enviar cotizaciones y seguimientos al cliente final.
RESEND_FROM_EMAIL=

# --- Stripe (cobro por suscripción) -----------------------------------------

# Llave secreta de Stripe (sk_live_... o sk_test_...).
STRIPE_SECRET_KEY=

# Secreto para verificar la firma de los webhooks de Stripe.
STRIPE_WEBHOOK_SECRET=

# ID del precio ($199/mes, 14 días de prueba) del producto "Socio Base".
STRIPE_PRICE_ID=

# --- Varios ------------------------------------------------------------------

# URL pública base del sitio (ej. https://app.socio-ai.com), usada para
# construir los links de /q/:token en emails y mensajes de WhatsApp.
APP_BASE_URL=

# Secreto compartido que protege la función de Vercel /api/quote-pdf para
# que solo las Edge Functions del propio proyecto puedan llamarla.
QUOTE_PDF_SHARED_SECRET=
